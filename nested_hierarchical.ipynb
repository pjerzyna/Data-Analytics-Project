    "# Shrinkage index — how many times the threshold changed\n",
    "df_compare['Threshold_Change_95%'] = df_compare['Prog_95_Ext'] / df_compare['Prog_95_Base']\n",
    "df_compare['Threshold_Change_99%'] = df_compare['Prog_99_Ext'] / df_compare['Prog_99_Base']\n",
    "\n",
    "# --- 3. VALIDATION ON 2024 DATA ---\n",
    "print(\"Applying thresholds to 2024 data...\")\n",
