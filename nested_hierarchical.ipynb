    "# BACKTESTING 2024 — COMPARISON OF BASELINE AND EXTENDED MODEL\n",
    "# ====================================================================\n",
    "\n",
    "# --- 1. EXTRACTING THRESHOLDS FROM THE EXTENDED MODEL ---\n",
    "print(\"Determining thresholds from the extended model...\")\n",
    "\n",
    "mu_samples_ext    = fit_ext.stan_variable(\"mu_sta\")     # (2000, 69)\n",
    "sigma_samples_ext = fit_ext.stan_variable(\"sigma_sta\")  # (2000, 69)\n",
    "\n",
    "# If not in memory:\n",
