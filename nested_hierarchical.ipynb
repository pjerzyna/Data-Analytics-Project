    "axes[1].plot(x_alpha, y_alpha, color='k', linewidth=2, label='Theoretical prior distribution')\n",
    "axes[1].set_title('Histogram of $\\\\alpha_c$ (Prior)', fontsize=12)\n",
    "axes[1].set_xlabel('$\\\\alpha_c$ (catchment area effect)')\n",
    "axes[1].legend()\n",
    "\n",
    "# Plot 3: simulated flows\n",
