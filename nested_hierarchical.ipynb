    "# ====================================================================\n",
    "# COMPARISON OF THRESHOLDS: Baseline vs v2\n",
    "# ====================================================================\n",
    "df_base_progi = pd.read_csv(\"progi_anomalii_model_podstawowy.csv\")\n",
    "df_v2_progi   = pd.read_csv(\"progi_anomalii_model_v2.csv\")\n",
    "\n",
    "df_porownanie = pd.merge(\n",
    "    df_base_progi[['Station_Name', 'Progowa_Anomalia_95%', 'Progowe_Ekstremum_99%']],\n",
    "    df_v2_progi[['Station_Name', 'Progowa_Anomalia_95%', 'Progowe_Ekstremum_99%']],\n",
    "    on='Station_Name',\n",
    "    suffixes=('_Base', '_V2')\n",
    ")\n",
    "\n",
    "df_porownanie['Change_95%'] = (\n",
    "    df_porownanie['Progowa_Anomalia_95%_V2'] /\n",
    "    df_porownanie['Progowa_Anomalia_95%_Base'] - 1\n",
    ") * 100\n",
    "\n",
    "pathologies = ['PTAKI', 'TUCHOLA', 'MYSZYNIEC', 'LOWICZ', 'WLODAWA']\n",
    "mask = df_porownanie['Station_Name'].str.upper().isin([p.upper() for p in pathologies])\n",
    "\n",
    "print(\"PATHOLOGICAL STATIONS — THRESHOLD CHANGE (Baseline → v2):\")\n",
    "print(\"-\" * 70)\n",
    "print(f\"{'Station':<15} {'Thresh95_Base':>12} {'Thresh95_V2':>10} {'Change %':>10}\")\n",
    "print(\"-\" * 70)\n",
    "for _, row in df_porownanie[mask].iterrows():\n",
    "    print(f\"{row['Station_Name']:<15} \"\n",
    "          f\"{row['Progowa_Anomalia_95%_Base']:>12.2f} \"\n",
    "          f\"{row['Progowa_Anomalia_95%_V2']:>10.2f} \"\n",
    "          f\"{row['Change_95%']:>+9.2f}%\")\n",
    "\n",
    "print(\"\\nTOP 10 STATIONS WITH THE LARGEST THRESHOLD CHANGE:\")\n",
    "top10 = df_porownanie.reindex(\n",
    "    df_porownanie['Change_95%'].abs().nlargest(10).index\n",
    ")[['Station_Name', 'Progowa_Anomalia_95%_Base', 'Progowa_Anomalia_95%_V2', 'Change_95%']]\n",
    "print(top10.to_string(index=False))"
   ]
  },
