    "\n",
    "z_95 = 1.644853\n",
    "z_99 = 2.326348\n",
    "\n",
    "q95_ext = np.exp(mu_samples_ext + z_95 * sigma_samples_ext)\n",
    "q99_ext = np.exp(mu_samples_ext + z_99 * sigma_samples_ext)\n",
    "\n",
    "thresholds_95_ext = np.median(q95_ext, axis=0)\n",
    "thresholds_99_ext = np.median(q99_ext, axis=0)\n",
