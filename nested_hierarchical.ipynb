    "# ============================================================\n",
    "# PRIOR PREDICTIVE CHECK – EXTENDED MODEL v2\n",
    "# ============================================================\n",
    "# Note: The prior Stan file is the same as for v1 — global \n",
    "# hyperparameters and hierarchical structure are identical. \n",
    "# The only addition is alpha_catchment ~ N(0, 0.5), which \n",
    "# we simulate separately below.\n",
    "# ============================================================\n",
    "\n",
    "model_ext_v2_prior = CmdStanModel(stan_file=\"stan/model_lognormal_ext_prior.stan\")\n",
    "\n",
    "print(\"Running Prior Predictive Check (extended model v2)...\")\n",
    "sim_ext_v2_prior = model_ext_v2_prior.sample(\n",
